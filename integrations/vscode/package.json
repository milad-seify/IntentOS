{
  "name": "intentos-vscode",
  "displayName": "IntentOS",
  "description": "Prepare bounded AI execution tasks with IntentOS.",
  "version": "0.1.0",
  "publisher": "milad-seyfi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/milad-seify/IntentOS.git",
    "directory": "integrations/vscode"
  },
  "homepage": "https://github.com/milad-seify/IntentOS/tree/main/integrations/vscode",
  "bugs": {
    "url": "https://github.com/milad-seify/IntentOS/issues"
  },
  "pricing": "Free",
  "keywords": [
    "intent",
    "prompt engineering",
    "ai"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:intentos.prepareTask"
  ],
  "contributes": {
    "commands": [
      {
        "command": "intentos.prepareTask",
        "title": "IntentOS: Prepare Task"
      }
    ],
    "configuration": {
      "title": "IntentOS",
      "properties": {
        "intentos.executable": {
          "type": "string",
          "default": "intentos",
          "description": "IntentOS CLI executable available to the VS Code extension host."
        }
      }
    }
  }
}
