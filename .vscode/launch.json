{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "IntentOS: Run VS Code Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/integrations/vscode",
        "--disable-extension=pflannery.vscode-versionlens",
        "${workspaceFolder}"
      ]
    }
  ]
}
